#usda 1.0
(
    doc = "OpenCable 8-belt prototype simulation scene"
    defaultPrim = "SlideprinterScene"
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 500
    upAxis = "Y"
)

# OpenCable simulation scene.
#
# Frame: 2440 x 1220 mm
# Carriage: 350 x 350 mm
#
# Native hp-sim5 cable topology:
#     fixed attachment -> moving pinhole/roller -> hybrid spool
#
# Four fixed frame anchors are shared pairwise by the eight belts.
# The eight moving pulley points are the eight geometric corners of the
# chamfered 350 x 350 mm carriage. The drawing is in millimetres; hp-sim5
# uses metres, so all carriage coordinates are converted by 0.001.

def Xform "World"
{
    def Xform "SlideprinterScene"
    {
        # ==============================================================
        # Four fixed frame anchors
        # ==============================================================
        def Xform "Anchor1"
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (-1.22, -0.61, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }
        def Xform "Anchor2"
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (1.22, -0.61, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }
        def Xform "Anchor3"
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (1.22, 0.61, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }
        def Xform "Anchor4"
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (-1.22, 0.61, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        # ==============================================================
        # Eight independent frame spools / hybrid motor endpoints
        # Existing frame positions are retained.
        # ==============================================================
        def Circle "SpoolA" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"])
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            double3 xformOp:translate = (-1.22, -0.46, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 0.027
            float3 physics:angularVelocity = (0,0,0)
            matrix3d physics:inertiaTensor = ((5e-5,0,0),(0,5e-5,0),(0,0,5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.01
        }
        def Circle "SpoolB" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"])
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            double3 xformOp:translate = (-1.07, -0.61, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 0.027
            float3 physics:angularVelocity = (0,0,0)
            matrix3d physics:inertiaTensor = ((5e-5,0,0),(0,5e-5,0),(0,0,5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.01
        }
