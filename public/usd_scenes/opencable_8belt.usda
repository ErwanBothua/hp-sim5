        # ==============================================================
        # Native hp-sim5 rigid-group carriage.
        # ==============================================================
        def RigidGroup "Carriage"
        {
            rel rigidGroup:members = [
                </World/SlideprinterScene/PulleyA>,
                </World/SlideprinterScene/PulleyB>,
                </World/SlideprinterScene/PulleyC>,
                </World/SlideprinterScene/PulleyD>,
                </World/SlideprinterScene/PulleyE>,
                </World/SlideprinterScene/PulleyF>,
                </World/SlideprinterScene/PulleyG>,
                </World/SlideprinterScene/PulleyH>
            custom string rigidGroup:renderIndices = "[0,1,2,3,4,5,6,7,0]"
            custom double stiffness = 1.0
        }

        # ==============================================================
        # Eight native cable paths.
        # Each path has exactly two CableJoints and three link types:
        # attachment -> pinhole -> hybrid.
        #
        # Anchor sharing:
        #   Anchor1 -> F,G
        #   Anchor2 -> D,E
        #   Anchor3 -> B,C
        #   Anchor4 -> A,H
        # Spool pairing follows the corresponding frame corner.
        # ==============================================================
        def CableJoint "JointA_0"
        {
            custom rel physics:body0 = </World/SlideprinterScene/Anchor4>
            custom rel physics:body1 = </World/SlideprinterScene/PulleyA>
            double restLength = 1.1735949046
            double2 localPos0 = (0,0)
            double2 localPos1 = (0,0)
        }
        def CableJoint "JointA_1"
        {
            custom rel physics:body0 = </World/SlideprinterScene/PulleyA>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolE>
            double restLength = 1.1266432443
            double2 localPos0 = (0,0)
            double2 localPos1 = (0,0)
        }
        def Xform "CablePathA" (apiSchemas = ["CablePathAPI"])
        {
            custom bool[] cablePath:clockwise = [1,1,1]
            custom rel cablePath:joints = [</World/SlideprinterScene/JointA_0>, </World/SlideprinterScene/JointA_1>]
            custom token[] cablePath:linkTypes = ["attachment","pinhole","hybrid"]
            custom double[] cablePath:stored = [0,0,0]
            custom double cablePath:stiffness = 20000.0
            custom double cablePath:damping = 0.0
            custom double cablePath:halfWidth = 0.001
            custom token[] cablePath:storedMode = ["manual","manual","manual"]
            custom token cablePath:initPolicy = "deriveMissing"
        }

