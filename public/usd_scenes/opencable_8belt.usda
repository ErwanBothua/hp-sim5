        # ==============================================================
        # Eight moving pulley points from the carriage drawing.
        # 350 x 350 mm, 45 mm corner chamfers.
        # Clockwise from upper-left: A-H.
        # ==============================================================
        def Circle "PulleyA" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"])
        {
            token[] ecs:tags = ["Pinhole"]
